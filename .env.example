# RANKD API Server — Environment Variables
#
# Copy this file to .env and fill in the values.
# Secrets (GITHUB_TOKEN, ADMIN_API_KEY) should be treated as sensitive —
# never commit them to version control.

# Server
PORT=3000

# CORS: comma-separated list of allowed origins
# CORS_ALLOWED_ORIGINS=https://rankd.example.com,https://username.github.io

# GitHub token for authenticated API requests (higher rate limits).
# Treat this as a secret — it grants access to GitHub API quotas tied to
# your account. Keep out of version control and logs.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Admin API key for protected endpoints (CRP version overrides).
# Treat this as a secret. Set to enable the /admin/crp/* endpoints.
# ADMIN_API_KEY=your-admin-key-here

# CRP overrides (optional, can also be managed via admin endpoint)
# CRP_SOFTWARE_VERSION=v1.3.1278
# CRP_LAST_RELEASED_AT=2026-04-16T00:00:00.000Z

# Logging
# LOG_LEVEL=info
# NODE_ENV=development
